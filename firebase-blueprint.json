{
  "entities": {
    "LiveUpdate": {
      "title": "LiveUpdate",
      "description": "Real-time synchronization event broadcast across clients",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "entity": { "type": "string" },
        "action": { "type": "string" },
        "actor": { "type": "string" },
        "actorRole": { "type": "string" },
        "timestamp": { "type": "string" },
        "payload": { "type": "object" }
      },
      "required": ["type", "entity", "actor", "timestamp"]
    },
    "Notification": {
      "title": "Notification",
      "description": "School announcement or academic alert notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "category": { "type": "string" },
        "targetRole": { "type": "string" },
        "read": { "type": "boolean" },
        "sender": { "type": "string" }
      },
      "required": ["title", "message", "timestamp", "category"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "School announcements broadcast across all users and dashboards in real-time",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "target": { "type": "string" },
        "category": { "type": "string" },
        "authorName": { "type": "string" },
        "publishedDate": { "type": "string" },
        "isImportant": { "type": "boolean" }
      },
      "required": ["title", "content", "target", "authorName", "publishedDate"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Real-time chat communication message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "channelId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string" },
        "senderAvatar": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["channelId", "senderId", "senderName", "senderRole", "content", "timestamp"]
    },
    "SystemBackup": {
      "title": "SystemBackup",
      "description": "Database backup or cloud sync record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "destination": { "type": "string" },
        "status": { "type": "string" },
        "size": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["timestamp", "destination", "status"]
    },
    "SchoolProfile": {
      "title": "SchoolProfile",
      "description": "Official institutional school profile identity synchronized across all accounts and roles",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "npsn": { "type": "string" },
        "level": { "type": "string" },
        "subtitle": { "type": "string" },
        "logo": { "type": "string" },
        "address": { "type": "string" },
        "village": { "type": "string" },
        "district": { "type": "string" },
        "city": { "type": "string" },
        "province": { "type": "string" },
        "postalCode": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "website": { "type": "string" },
        "principalName": { "type": "string" },
        "principalNip": { "type": "string" },
        "accreditation": { "type": "string" },
        "themeColor": { "type": "string" }
      },
      "required": ["name", "npsn"]
    }
  },
  "firestore": {
    "/system_config/school_profile": {
      "schema": "SchoolProfile",
      "description": "Global official school identity profile synchronized across all accounts and clients"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Real-time school announcements broadcast across all dashboards"
    },
    "/live_updates/{updateId}": {
      "schema": "LiveUpdate",
      "description": "Collection of real-time state synchronization events"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Collection of real-time school notifications"
    },
    "/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Real-time chat messages across school channels"
    },
    "/system_backups/{backupId}": {
      "schema": "SystemBackup",
      "description": "Audit records of Google Drive and cloud database backups"
    }
  }
}
